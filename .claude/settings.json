{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|Write|Edit",
        "hooks": [{ "type": "command", "command": "bash scripts/guard-raw-data.sh" }] },
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash scripts/block-plant-api.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "bash scripts/lint-test.sh" }] }
    ]
  }
}
