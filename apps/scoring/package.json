{
  "name": "plant-scoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cron Worker: once per sim day, score anomaly z-scores and failure risk from D1 readings and the model artefacts; write runs, predictions, alerts, work orders",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy:staging": "wrangler deploy --env staging",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
