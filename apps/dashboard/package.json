{
  "name": "plant-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public management dashboard: static page plus /api/* proxy that holds the tokens server-side",
  "scripts": {
    "dev": "wrangler dev --port 8790",
