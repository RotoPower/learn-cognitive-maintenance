{
  "name": "plant-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cron Worker: every minute, read /tags/latest from the plant API and upsert into D1 readings (idempotent on tag, ts)",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy:staging": "wrangler deploy --env staging",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
